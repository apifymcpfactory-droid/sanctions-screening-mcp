{
  "name": "sanctions-screening",
  "version": "1.0.0",
  "description": "Screen names, companies and crypto addresses against the official OFAC, EU, UK and UN sanctions lists with deterministic, transliteration-aware fuzzy matching, cross-list consolidation and false-positive analysis.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "chalk": "^5.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.10.1",
    "pdf-lib": "^1.17.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
